---
import { Image } from "astro:assets";

const {image, name, linkedin, isLarge = false, title} = Astro.props;
import linkedinicon from '../content/icon-li-sm.png'
---
<div class="flex flex-col items-center px-4 py-2">
	<div class="relative mx-auto w-48 h-48 rounded-full overflow-hidden shadow-xl">
		<Image height={768} width={768} src={image} alt="Profile" class="w-full h-full object-cover" />
	</div>
	<div class="pt-1 lg:text-xl font-bold">{name}</div>
	<div class="pt-1 lg:text-lg text-sm font-roboto pb-1" >{title}</div>
	<a href={linkedin} target="_blank" rel="noopener noreferrer">
		<img src={linkedinicon.src} width="24">	
	</a>
</div>